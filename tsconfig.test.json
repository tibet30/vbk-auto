{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.cts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/main/automation/ctrip/**",
    "src/main/automation/workflow.ts",
    "src/main/automation/browser.ts",
    "src/main/infrastructure/vbk-browser.ts"
  ]
}